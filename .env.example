# DeepSeek (server only — never commit real key)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: ProxyAPI OpenAI-compatible (day05 multi-model). Never commit real key.
# PROXYAPI_API_KEY=
# PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1

# Optional: model list EXACTLY as given (comma-separated) — tiers without an
# entry drop out of the UI list (day19, решение Кости: strong не в списке;
# вернуть временно только на пересъёмку — паттерн day08/18).
# DEMO_MODELS=gemini/gemini-2.5-flash-lite,google/gemini-2.5-flash

# Server
PORT=3000
NODE_ENV=development

# Optional: override path to data/ (default: repo root/data)
# DATA_DIR=

# Optional: VPS usage totals file (default: repo root/var/usage-totals.json)
# USAGE_FILE=

# Optional: day07 agent context file (default: repo root/var/agent-state.json)
# AGENT_STATE_FILE=

# Day18: background scheduler — PubMed digest jobs + proactive summaries.
# Store file (default: repo root/var/scheduler.json).
# SCHEDULER_FILE=
# Min seconds between proactive LLM digests (default 900 = 15 min; ceiling ~9–10 ₽/day,
# hard stop — DAILY_BUDGET_RUB). Demo/screencast: 90 via systemctl set-environment, unset after.
# SCHEDULE_SUMMARY_MIN_SEC=900

# Day19: pipeline tools — saved files dir (default: repo root/var/pipelines).
# On the VPS set an ABSOLUTE path (day18 lesson: verify the actual path in the first smoke).
# PIPELINES_DIR=

# Day20: orchestration — external MCP servers (comma-separated name=url, name [a-z0-9]+).
# Own server (trigger-helper-atlas) is always registered from PORT; unset = own-only (day19).
# Fail-closed: a server WITHOUT its MCP_INJECT_<NAME> key injects NOTHING into the LLM
# (boot warning + injectCount 0 in GET /api/mcp/tools). Tool listings are baseline-checked
# at boot (server/src/services/mcp-registry.baseline.json) — mismatch = degraded.
# MCP_SERVERS=pubmed=https://pubmed.caseyjhand.com/mcp
# Inject subset (native names; their search duplicates our own search — never inject it):
# MCP_INJECT_PUBMED=pubmed_find_related,pubmed_lookup_mesh,pubmed_format_citations

# Daily cap for expensive models only (Moscow day). 0 = off.
# Cheap: DeepSeek, gemini flash(-lite), gpt-4o-mini, haiku — unlimited.
FREE_DAILY_ASKS=20

# Day06 Agent demo caps (persisted to var/agent-state.json)
# MAX_INSTANCES=8
# MAX_AGENTS_PER_INSTANCE=16

# Day08 demo: force a small context window (tokens) for all models —
# shows the overflow guard (413) without a huge thread. 0 = per-model limit.
# DEMO_CONTEXT_LIMIT=4000

# Day09: auto-compress the thread every M dialogue messages (beyond the
# keepLast=4 tail) before answering. 0 = off. Lab override per request wins.
# For a quick smoke, force a small value (e.g. 4 → compressions on the 5th and 7th asks).
# AGENT_COMPRESS_EVERY=10
# Day10 demo comparison: keep compressEvery=0 (Lab or env) so sliding/facts/branching
# are not mixed with day09 auto-compress. Facts extract uses DEEPSEEK_MODEL (no new env).

# Per-IP rate limit for ask/compare/agent/spawn/create (0 = off)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
# Dev / office IPs — skip IP rate only (not ₽ budget). Comma-separated.
# RATE_LIMIT_ALLOWLIST=127.0.0.1,::1

# Cost-aware daily ₽ budgets (Moscow day). Package B. 0 = throttle off.
# DAILY_BUDGET_RUB=300
# DAILY_BUDGET_EXPENSIVE_RUB=150
# BUDGET_DELAY_ALPHA=2.5
# BUDGET_DELAY_BETA=2
# BUDGET_DELAY_FILL_MS=20000
# BUDGET_DELAY_PACE_MS=60000
# BUDGET_DELAY_MAX_MS=180000

# Demo / screencast (VPS only) — restore package B (300/150) after.
# NOT B=1: sonnet ~1.5–3 ₽/turn won't fit. Use 15/10 → delay ~2s after ~6 ₽.
# If usage.budget.used_rub already high: B ≈ used_rub/0.4 (and B > used).
# DAILY_BUDGET_RUB=15
# DAILY_BUDGET_EXPENSIVE_RUB=10
